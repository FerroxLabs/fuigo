{
    "name": "fuigo",
    "version": "1.0.9",
    "description": "Bring Fuigo into your terminal",
    "license": "Apache-2.0",
    "bin": {
        "fuigo": "bin/fuigo"
    },
    "files": [
        "bin/",
        "LICENSE",
        "NOTICE",
        "THIRD-PARTY-NOTICES",
        "THIRD_PARTY_NOTICES.md",
        "vendor-notices/"
    ],
    "os": [
        "darwin",
        "linux",
        "win32"
    ],
    "cpu": [
        "arm64",
        "x64"
    ],
    "scripts": {
        "postinstall": "node bin/postinstall.js",
        "sync-version": "node scripts/sync-version.js",
        "check-version": "node scripts/sync-version.js --check",
        "assemble": "node scripts/assemble-platform-packages.js",
        "prepublishOnly": "node scripts/sync-version.js --check && node scripts/package-notices.js --check"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "@iarna/toml": "^3.0.0"
    },
    "optionalDependencies": {
        "@fuigo/darwin-arm64": "1.0.9",
        "@fuigo/darwin-x64": "1.0.9",
        "@fuigo/linux-arm64": "1.0.9",
        "@fuigo/linux-x64": "1.0.9",
        "@fuigo/win32-arm64": "1.0.9",
        "@fuigo/win32-x64": "1.0.9"
    }
}
